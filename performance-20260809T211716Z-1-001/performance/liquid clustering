## 13. Quick Reference Cheat Sheet

```sql
-- Create with clustering
CREATE TABLE my_table (...) CLUSTER BY (col1, col2);

-- Add clustering to existing table
ALTER TABLE my_table CLUSTER BY (col1, col2);

-- Remove clustering
ALTER TABLE my_table CLUSTER BY NONE;

-- Run incremental optimize
OPTIMIZE my_table;

-- Optimize specific partition of data
OPTIMIZE my_table WHERE event_date >= '2025-01-01';

-- Check clustering columns
DESCRIBE DETAIL my_table;

-- Enable auto optimize
ALTER TABLE my_table SET TBLPROPERTIES (
  'delta.autoOptimize.optimizeWrite' = 'true',
  'delta.autoOptimize.autoCompact'   = 'true'
);

-- Enable predictive optimization
ALTER TABLE my_table SET TBLPROPERTIES (
  'delta.predictiveOptimization' = 'enable'
);
```

