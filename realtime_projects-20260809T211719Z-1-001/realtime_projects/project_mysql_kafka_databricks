        ON DUPLICATE KEY UPDATE pulse_ts = NOW(), hostname = @@hostname
    """)
    conn.commit()
    conn.close()
    print(f"Heartbeat written at {time.strftime('%H:%M:%S')}")

schedule.every(5).minutes.do(write_heartbeat)
while True:
    schedule.run_pending()
