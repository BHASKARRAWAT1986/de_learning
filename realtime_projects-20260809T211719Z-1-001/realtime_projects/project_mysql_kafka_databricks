         ELSE                                     'CRITICAL' END AS status,
    seconds_since_last_batch || 's since last batch' AS detail
FROM monitoring.dlt_batch_stats
WHERE ts = (SELECT MAX(ts) FROM monitoring.dlt_batch_stats)

UNION ALL

