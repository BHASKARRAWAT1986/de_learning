## 4. Databricks DLT Pipeline

### 4.1 Pipeline Architecture

```
Kafka Topics
    │
    ▼
┌─────────────────────────────────────────────────────────────────────┐
│                    DLT PIPELINE                                      │
│                                                                      │
│  ┌─────────────────────────────┐                                    │
│  │  BRONZE LAYER (Streaming)   │  ← raw CDC events, append-only    │
│  │  bronze_orders_raw          │    no transformation               │
│  │  bronze_users_raw           │    Parquet + Delta                 │
│  │  bronze_products_raw        │    quarantine bad records          │
│  └──────────────┬──────────────┘                                    │
│                 │                                                    │
│  ┌──────────────▼──────────────┐                                    │
│  │  SILVER LAYER (Streaming)   │  ← deduplicated, merged           │
│  │  silver_orders              │    APPLY CHANGES INTO (SCD Type 1) │
│  │  silver_users               │    current state of source tables  │
│  │  silver_products            │    business rules applied          │
│  └─────────────────────────────┘                                    │
└─────────────────────────────────────────────────────────────────────┘
```

### 4.2 Bronze Layer DLT Definition

```python
import dlt
from pyspark.sql import functions as F
from pyspark.sql.types import StructType, StructField, StringType, LongType

# ─────────────────────────────────────────────────────────────────
# BRONZE: Raw CDC events from Kafka — append-only, no transformation
# ─────────────────────────────────────────────────────────────────

KAFKA_BOOTSTRAP = spark.conf.get("kafka.bootstrap.servers")  # from DLT config

@dlt.table(
    name="bronze_orders_raw",
    comment="Raw CDC events from MySQL orders table via Debezium/Kafka",
    table_properties={
        "delta.autoOptimize.optimizeWrite": "true",
        "delta.autoOptimize.autoCompact": "true",
        "pipelines.reset.allowed": "false"  # Never truncate bronze — it's the audit trail
    }
)
@dlt.expect_or_drop("valid_kafka_value", "value IS NOT NULL")
def bronze_orders_raw():
    return (
        spark.readStream
            .format("kafka")
            .option("kafka.bootstrap.servers", KAFKA_BOOTSTRAP)
            .option("subscribe", "prod_mysql.ecommerce.orders")
            .option("startingOffsets", "latest")        # or "earliest" for backfill
            .option("maxOffsetsPerTrigger", "100000")   # flow control
            .option("kafka.security.protocol", "SASL_SSL")
            .option("kafka.sasl.mechanism", "PLAIN")
            .option("kafka.sasl.jaas.config", spark.conf.get("kafka.sasl.jaas"))
            .load()
            # Keep raw Kafka metadata alongside payload
            .select(
                F.col("topic"),
                F.col("partition"),
                F.col("offset"),
                F.col("timestamp").alias("kafka_timestamp"),
                F.col("value").cast("string").alias("raw_payload"),   # keep raw JSON
                # Parse the Debezium payload
                F.get_json_object(F.col("value").cast("string"), "$.payload.op")
                    .alias("cdc_op"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.ts_ms")
                    .cast("long").alias("cdc_ts_ms"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.source.file")
                    .alias("binlog_file"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.source.pos")
                    .cast("long").alias("binlog_pos"),
                # Extract the 'after' image (current state of row)
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.id")
                    .cast("long").alias("order_id"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.status")
                    .alias("status"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.amount")
                    .cast("double").alias("amount"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.customer_id")
                    .cast("long").alias("customer_id"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.updated_at")
                    .cast("long").alias("source_updated_at_ms"),
                # Ingestion metadata
                F.current_timestamp().alias("ingested_at"),
                F.lit("kafka_debezium").alias("source_system")
            )
    )


# ─────────────────────────────────────────────────────────────────
# BRONZE QUARANTINE: Bad/unparseable records go here — never lost
# ─────────────────────────────────────────────────────────────────

@dlt.table(
    name="bronze_orders_quarantine",
    comment="Malformed or unparseable CDC events — manual review required"
)
@dlt.expect_or_drop("is_quarantine_record", "cdc_op IS NULL OR order_id IS NULL")
def bronze_orders_quarantine():
    return (
        spark.readStream
            .format("kafka")
            .option("kafka.bootstrap.servers", KAFKA_BOOTSTRAP)
            .option("subscribe", "prod_mysql.ecommerce.orders")
            .option("startingOffsets", "latest")
            .load()
            .select(
                F.col("value").cast("string").alias("raw_payload"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.op").alias("cdc_op"),
                F.get_json_object(F.col("value").cast("string"), "$.payload.after.id")
                    .cast("long").alias("order_id"),
                F.current_timestamp().alias("quarantined_at"),
                F.lit("parse_failure").alias("quarantine_reason")
            )
            .filter("cdc_op IS NULL OR order_id IS NULL")   # only bad records
    )
```

### 4.3 Silver Layer DLT — APPLY CHANGES INTO (CDC-native)

This is the **most important part** — DLT's `APPLY CHANGES INTO` handles CDC semantics natively.

```python
# ─────────────────────────────────────────────────────────────────
# SILVER: Current state of orders table — SCD Type 1 (latest wins)
# Uses DLT's APPLY CHANGES INTO which handles:
#   - Out-of-order events (using sequence_by)
#   - INSERT/UPDATE/DELETE operations
#   - Exactly-once upsert semantics
# ─────────────────────────────────────────────────────────────────

dlt.create_streaming_table(
    name="silver_orders",
    comment="Current state of orders — deduplicated, merged from CDC stream",
    table_properties={
        "delta.enableDeletionVectors": "true",
        "delta.autoOptimize.optimizeWrite": "true",
        "pipelines.autoOptimize.managed": "true"
    },
    # Data quality expectations
    expect_all_or_drop={
        "valid_order_id":  "order_id IS NOT NULL",
        "valid_amount":    "amount >= 0",
        "valid_status":    "status IN ('PENDING','PROCESSING','SHIPPED','DELIVERED','CANCELLED')"
    }
)

dlt.apply_changes(
    target         = "silver_orders",
    source         = "bronze_orders_raw",
    keys           = ["order_id"],              # Primary key from MySQL
    sequence_by    = F.col("cdc_ts_ms"),        # Use MySQL change timestamp to order events
    ignore_null_updates = False,                # Apply NULL values too
    apply_as_deletes = F.expr("cdc_op = 'd'"),  # Treat op='d' events as deletes
    apply_as_truncates = F.expr("cdc_op = 't'"),# Handle TRUNCATE events
    column_list    = [
        "order_id", "customer_id", "status", "amount",
        "source_updated_at_ms", "ingested_at"
    ],
    # SCD Type 1: overwrite previous values (no history kept in silver)
    # For SCD Type 2 use: stored_as_scd_type="2"
    stored_as_scd_type = "1"
)
```

**Why `sequence_by = cdc_ts_ms`?**  
Kafka does not guarantee strict ordering across partitions. If UPDATE event arrives before INSERT (network reorder), `sequence_by` ensures the lower-timestamp event is ignored — the row always reflects the chronologically latest state.

### 4.4 Handling DELETE Events in Silver

```python
# Option A: Hard deletes (physically remove row from silver)
# (default behavior in APPLY CHANGES with apply_as_deletes)

# Option B: Soft deletes (mark as deleted, keep the row)
dlt.apply_changes(
    target      = "silver_orders",
    source      = "bronze_orders_raw",
    keys        = ["order_id"],
    sequence_by = F.col("cdc_ts_ms"),
    apply_as_deletes  = F.expr("cdc_op = 'd'"),
    # Override: instead of deleting, set is_deleted=true
    # This is done by adding the flag in bronze before silver reads it
)

# Better pattern: enrich bronze with soft-delete flag, silver inherits it
# In bronze transformation:
.withColumn("is_deleted", F.when(F.col("cdc_op") == "d", True).otherwise(False))
.withColumn("is_active",  F.when(F.col("cdc_op") != "d", True).otherwise(False))
```

