#### Python Script: Check Lag Programmatically
```python
# monitoring/check_kafka_lag.py
from confluent_kafka.admin import AdminClient
from confluent_kafka import Consumer, TopicPartition

BOOTSTRAP   = "broker1:9092,broker2:9092"
GROUP_ID    = "dlt-mysql-cdc-consumer"
TOPICS      = [
    "prod_mysql.ecommerce.orders",
    "prod_mysql.ecommerce.users",
    "prod_mysql.ecommerce.products"
]
LAG_ALERT_THRESHOLD = 5000   # alert if any partition is 5000+ messages behind

admin = AdminClient({"bootstrap.servers": BOOTSTRAP})
consumer = Consumer({
    "bootstrap.servers": BOOTSTRAP,
    "group.id":          GROUP_ID + "-monitor",   # separate group, read-only
    "enable.auto.commit": False
})

def get_partition_lag(topic):
    # Get partition metadata
    metadata = admin.list_topics(topic=topic, timeout=10)
    partitions = list(metadata.topics[topic].partitions.keys())
    
    tps = [TopicPartition(topic, p) for p in partitions]
    
    # Get consumer group committed offsets
    committed = consumer.committed(tps, timeout=10)
    
    # Get latest (end) offsets
    high_watermarks = {}
    consumer.assign(tps)
    end_offsets = consumer.get_watermark_offsets
    
    results = []
    for tp in tps:
        committed_offset = tp.offset if tp.offset >= 0 else 0
        # Get end offset for this partition
        low, high = consumer.get_watermark_offsets(tp, timeout=5)
        lag = high - committed_offset
        results.append({
            "topic":     topic,
            "partition": tp.partition,
            "committed": committed_offset,
            "end":       high,
            "lag":       lag,
            "status":    "ALERT" if lag > LAG_ALERT_THRESHOLD else "OK"
        })
    return results

for topic in TOPICS:
    lags = get_partition_lag(topic)
    for row in lags:
        status_icon = "🔴" if row["status"] == "ALERT" else "🟢"
        print(f"{status_icon} {row['topic']} P{row['partition']} | "
              f"committed={row['committed']:,} | end={row['end']:,} | lag={row['lag']:,}")

consumer.close()
```

