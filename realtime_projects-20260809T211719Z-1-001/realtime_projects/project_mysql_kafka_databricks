         ELSE                                 'CRITICAL' END AS status,
    max_partition_lag || ' messages behind'    AS detail
FROM monitoring.kafka_lag
WHERE ts = (SELECT MAX(ts) FROM monitoring.kafka_lag)

UNION ALL

SELECT
    'DLT Pipeline'  AS component,
    CASE WHEN seconds_since_last_batch < 90  THEN 'HEALTHY'
