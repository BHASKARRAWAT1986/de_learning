#### Heartbeat DLT Table
```python
# In the DLT pipeline — add a heartbeat table alongside bronze/silver

@dlt.table(name="bronze_heartbeat")
def bronze_heartbeat():
    return (
        spark.readStream
            .format("kafka")
            .option("kafka.bootstrap.servers", KAFKA_BOOTSTRAP)
            .option("subscribe", "prod_mysql.ecommerce.heartbeat")
            .option("startingOffsets", "latest")
            .load()
            .select(
                F.get_json_object(F.col("value").cast("string"),
                    "$.payload.after.pulse_ts").cast("long").alias("pulse_ts_ms"),
                F.current_timestamp().alias("arrived_at"),
                F.col("timestamp").alias("kafka_ts")
            )
    )

dlt.create_streaming_table("silver_heartbeat")
dlt.apply_changes(
    target     = "silver_heartbeat",
    source     = "bronze_heartbeat",
    keys       = [F.lit(1).alias("id")],  # singleton row
    sequence_by = F.col("pulse_ts_ms")
)
