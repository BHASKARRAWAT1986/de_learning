#### Automated Connector Health Check Script
```python
# monitoring/check_debezium_health.py
# Run this as a Databricks Job every 5 minutes

import requests
import json

CONNECT_URL  = "http://kafka-connect:8083"
CONNECTORS   = ["mysql-orders-connector", "mysql-users-connector", "mysql-products-connector"]
ALERT_WEBHOOK = "https://hooks.slack.com/services/xxx"  # or PagerDuty

def check_connector(name):
    url = f"{CONNECT_URL}/connectors/{name}/status"
    resp = requests.get(url, timeout=10)
    resp.raise_for_status()
    status = resp.json()
    
    connector_state = status["connector"]["state"]
    task_states = [t["state"] for t in status["tasks"]]
    
    is_healthy = (connector_state == "RUNNING" and all(s == "RUNNING" for s in task_states))
    
    return {
        "connector":        name,
        "connector_state":  connector_state,
        "task_states":      task_states,
        "healthy":          is_healthy,
        "error_trace":      status["tasks"][0].get("trace") if not is_healthy else None
    }

def restart_connector_if_failed(name):
    """Auto-restart a FAILED connector — handles transient failures"""
    url = f"{CONNECT_URL}/connectors/{name}/restart?includeTasks=true&onlyFailed=true"
    resp = requests.post(url, timeout=10)
    return resp.status_code == 204  # 204 = restarted successfully

for connector in CONNECTORS:
    result = check_connector(connector)
    
    if not result["healthy"]:
        print(f"UNHEALTHY: {connector} — {result['error_trace'][:200]}")
        
        # Attempt auto-restart (handles transient Connect worker crashes)
        restarted = restart_connector_if_failed(connector)
        
        if not restarted:
            # Send PagerDuty / Slack alert
            requests.post(ALERT_WEBHOOK, json={
                "text": f":red_circle: Debezium connector FAILED: {connector}\n"
                        f"Error: {result['error_trace'][:300]}\n"
                        f"Auto-restart: {'SUCCESS' if restarted else 'FAILED — manual intervention needed'}"
            })
    else:
        print(f"HEALTHY: {connector} | tasks: {result['task_states']}")
```

